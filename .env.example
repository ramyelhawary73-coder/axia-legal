# D1 is isolated only. Do not enable before separate migration/bootstrap/MFA approval.
AXIA_PLATFORM_CONTROL_ENABLED=0
# Exact reviewed HTTPS origin for MFA POST requests; no path/query/fragment.
AXIA_PLATFORM_CONTROL_ORIGIN=
